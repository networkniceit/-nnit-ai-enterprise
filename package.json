{
  "name": "nnit-ai-enterprise",
  "version": "1.0.0",
  "description": "NNIT AI Enterprise - AI-Powered Freelancer Platform (100% Free)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "start": "node backend/dist/server.js",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/networkniceit/-nnit-ai-enterprise.git"
  },
  "keywords": [
    "ai",
    "freelancer",
    "platform",
    "jobs",
    "matching",
    "enterprise"
  ],
  "author": "NNIT",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/networkniceit/-nnit-ai-enterprise/issues"
  },
  "homepage": "https://github.com/networkniceit/-nnit-ai-enterprise#readme",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
